# Copiar a .env (NUNCA commitear) y cargar con: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.

# Credenciales de la app (portal de partners de Tiendanube)
TN_APP_ID=<YOUR_APP_ID>
TN_APP_SECRET=<YOUR_APP_SECRET>
TN_USER_AGENT=KlaviyoConnector (<YOUR_CONTACT_EMAIL>)

# 32 bytes aleatorios en base64:  openssl rand -base64 32
# Cifra los access tokens de TN y las API keys de Klaviyo en reposo. Si se pierde, hay que reconectar todo.
ENCRYPTION_KEY=<BASE64_32_BYTES>

# Origen(es) del frontend, separados por coma. Nunca "*".
ALLOWED_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>

ENVIRONMENT=production

# Session token de Nexo: el store id viaja en el claim `storeId` (verificado con un token real) y `aud` = ID de la app.
# Solo cambiar si Tiendanube modifica el formato del token.
# SESSION_STORE_CLAIM=storeId
# SESSION_ISS=
# SESSION_AUD=

# Opcionales
# TN_API_VERSION=2025-03
# KLAVIYO_REVISION=2025-10-15

# SOLO desarrollo local. Con ENVIRONMENT=production se ignora.
# ALLOW_INSECURE_DEV_AUTH=true
