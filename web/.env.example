# URL base de las Edge Functions (sin barra final)
VITE_FUNCTIONS_URL=https://<YOUR_PROJECT_REF>.supabase.co/functions/v1

# Client ID de la app en el portal de partners (lo usa el SDK Nexo)
VITE_TN_APP_ID=<YOUR_APP_ID>

# SOLO desarrollo local con ALLOW_INSECURE_DEV_AUTH=true en el backend. Dejar vacío en producción.
VITE_DEV_STORE_ID=
